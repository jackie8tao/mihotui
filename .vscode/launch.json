{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Mihomo TUI (External Terminal)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/mihotui",
            "console": "externalTerminal",
            "env": {
                "MIHOMO_API_URL": "http://127.0.0.1:9097",
                "MIHOMO_SECRET": "taodf8989"
            },
            "args": []
        },
        {
            "name": "Launch Mihomo TUI (Integrated Terminal)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/mihotui",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "env": {
                "MIHOMO_API_URL": "http://127.0.0.1:9097",
                "MIHOMO_SECRET": "taodf8989"
            },
            "args": []
        },
        {
            "name": "Launch Mihomo TUI (Custom Config)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/mihotui",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "args": [
                "-c",
                "${workspaceFolder}/configs/config.example.yaml"
            ]
        },
        {
            "name": "Debug Current Test File",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "showLog": true,
            "args": [
                "-test.v"
            ]
        },
        {
            "name": "Debug Single Test at Cursor",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "showLog": true,
            "args": [
                "-test.v",
                "-test.run",
                "^${selectedText}$"
            ]
        },
        {
            "name": "Attach to Local Process",
            "type": "go",
            "request": "attach",
            "mode": "local",
            "processId": 0
        }
    ]
}